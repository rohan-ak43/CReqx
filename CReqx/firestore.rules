rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: A user can only read/write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Watched Movies subcollection
      match /watchedMovies/{movieId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Watchlist subcollection
      match /watchlist/{movieId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Recommendation History subcollection
      match /recommendationHistory/{recId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Block all other reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
