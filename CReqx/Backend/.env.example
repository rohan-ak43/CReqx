# Copy to .env and fill in locally. Never commit the real .env.

# Where the raw Kaggle "Movies Dataset" CSVs live (movies_metadata.csv,
# keywords.csv, links_small.csv, ratings_small.csv).
CREQX_DATA_DIR=./Dataset

# Where trained model artifacts are written/read.
CREQX_ARTIFACT_DIR=./artifacts

# Frontend origin allowed to call this API (CORS).
CREQX_ALLOWED_ORIGIN=http://localhost:5173

FLASK_DEBUG=1
PORT=5000
